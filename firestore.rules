rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function me() { return request.auth.uid; }
    function notBanned() {
      return get(/databases/$(database)/documents/users/$(me())).data.banned == false;
    }
    // A normal member in good standing: verified email and not banned.
    function active() { return verified() && notBanned(); }

    // Guests use Firebase anonymous sign-in. They can chat (requests, online, blind chat) but cannot send pictures or like.
    function isGuest() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function guestOk() {
      return isGuest()
        && exists(/databases/$(database)/documents/guests/$(me()))
        && get(/databases/$(database)/documents/guests/$(me())).data.banned == false;
    }
    function canLobby() { return guestOk() || active(); }   // "can chat": member in good standing or guest in good standing

    // Conversation ids are "<uidA>_<uidB>" with uidA < uidB.
    function validConvId(convId) {
      let p = convId.split('_');
      return p.size() == 2 && p[0] < p[1] && me() in p;
    }
    function otherUser(convId) {
      let p = convId.split('_');
      return p[0] == me() ? p[1] : p[0];
    }
    function notBlocked(convId) {
      let other = otherUser(convId);
      return !exists(/databases/$(database)/documents/blocks/$(me() + '_' + other))
          && !exists(/databases/$(database)/documents/blocks/$(other + '_' + me()));
    }

    // ------------------------------------------------------------ profiles
    function validProfileFields(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 40
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 60
        && d.bio is string && d.bio.size() <= 500
        && d.gender in ['male', 'female']
        && d.lookingFor in ['male', 'female']
        && d.dob is timestamp
        // 18 years (6575 days is the conservative upper bound incl. leap days)
        && d.dob <= request.time - duration.value(6575, 'd')
        && validGeo(d)
        && validExtra(d);
    }

    // Optional coarse location: integer grid cell (~5 km), both fields or neither.
    function validGeo(d) {
      return (('gx' in d) == ('gy' in d))
        && (!('gx' in d) || (d.gx is int && d.gy is int
            && d.gx >= -1800 && d.gx <= 1800 && d.gy >= -3600 && d.gy <= 3600));
    }

    // Optional "more about me" fields and the small main-photo thumbnail.
    function validExtra(d) {
      return (!('job' in d) || (d.job is string && d.job.size() <= 60))
        && (!('school' in d) || (d.school is string && d.school.size() <= 60))
        && (!('height' in d) || (d.height is int && d.height >= 120 && d.height <= 230))
        && (!('goal' in d) || d.goal in ['long', 'short', 'friends', 'open'])
        && (!('interests' in d) || (d.interests is list && d.interests.size() <= 6))
        && (!('thumb' in d) || (d.thumb is string && d.thumb.size() <= 80000));
    }

    match /users/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin() || active() || guestOk());
      // Guests may only list members who are online right now (the Online page); Discover stays members-only.
      allow list: if isAdmin() || active()
        || (guestOk() && resource.data.lastSeen > request.time - duration.value(10, 'm'));

      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'dob', 'gender', 'lookingFor', 'city', 'bio',
                                                 'adultConfirmed', 'consentAt', 'createdAt', 'banned', 'hidden', 'gx', 'gy'])
        && request.resource.data.keys().hasAll(['name', 'dob', 'gender', 'lookingFor', 'city', 'bio',
                                                'adultConfirmed', 'consentAt', 'createdAt', 'banned', 'hidden'])
        && validProfileFields(request.resource.data)
        && request.resource.data.adultConfirmed == true
        && request.resource.data.consentAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.banned == false
        && request.resource.data.hidden == false;

      allow update:
        // owner: profile text, extra info, thumbnail and the optional coarse location, never while banned
        if (signedIn() && me() == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'city', 'bio', 'gx', 'gy',
                                                                                   'thumb', 'job', 'school', 'height', 'goal', 'interests'])
              && validProfileFields(request.resource.data)
              && resource.data.banned == false)
        // presence: owner may stamp (or clear) only "lastSeen"; the stamp must be the server time
        || (verified() && me() == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
              && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen == request.time)
              && resource.data.banned == false)
        // admin: may only flip "banned", and never on admin accounts (they are hidden)
        || (isAdmin()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned'])
              && resource.data.hidden == false);

      allow delete: if false;
    }

    // Up to 4 profile photos (compressed JPEG data URLs). Readable by members and guests, writable by the owner only.
    function okPic(p, i) {
      return p.size() <= i || (p[i] is string && p[i].size() > 100 && p[i].size() <= 200000);
    }
    function validPhotos(d) {
      return d.keys().hasOnly(['p', 'updatedAt'])
        && d.p is list && d.p.size() <= 4
        && okPic(d.p, 0) && okPic(d.p, 1) && okPic(d.p, 2) && okPic(d.p, 3)
        && d.updatedAt == request.time;
    }
    match /photos/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin() || active() || guestOk());
      allow list: if false;
      allow create, update: if active() && me() == uid && validPhotos(request.resource.data);
      allow delete: if active() && me() == uid;
    }

    // Email lives here (not in the public profile). Owner and admins only.
    match /userPrivate/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------ likes (swipe right). Members only.
    // A like is readable by the two people involved, so a match can be detected.
    match /likes/{likeId} {
      allow read: if active() && (resource.data.from == me() || resource.data.to == me());
      allow create: if active()
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.from == me()
        && request.resource.data.to is string
        && request.resource.data.to != me()
        && likeId == me() + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------ blocks
    match /blocks/{blockId} {
      allow read: if active() && resource.data.blockerId == me();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['blockerId', 'blockedId', 'createdAt'])
        && request.resource.data.blockerId == me()
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != me()
        && blockId == me() + '_' + request.resource.data.blockedId
        && request.resource.data.createdAt == request.time;
      allow delete: if active() && resource.data.blockerId == me();
      allow update: if false;
    }

    // ------------------------------------------------------------ reports
    match /reports/{reportId} {
      allow create: if (active() || guestOk())
        && request.resource.data.keys().hasOnly(['reporterId', 'reportedId', 'reason', 'resolved', 'createdAt'])
        && request.resource.data.reporterId == me()
        && request.resource.data.reportedId is string
        && request.resource.data.reportedId != me()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 500
        && request.resource.data.resolved == false
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
      allow delete: if false;
    }

    // ------------------------------------------------------------ audit log + access grants
    // Append-only. Admins can write entries about themselves, never edit or delete them.
    match /auditLog/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['adminUid', 'adminEmail', 'action', 'target', 'reason', 'createdAt'])
        && request.resource.data.adminUid == me()
        && request.resource.data.adminEmail == request.auth.token.email
        && request.resource.data.action in ['view_conversation', 'ban', 'unban', 'resolve_report',
                                         'ban_guest', 'unban_guest', 'delete_message']
        && request.resource.data.target is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    function auditAfter(auditId) {
      return getAfter(/databases/$(database)/documents/auditLog/$(auditId)).data;
    }

    // A grant lets an admin read ONE conversation for 10 minutes. It can only be written in the
    // same batch as a brand-new audit entry (createdAt == request.time) for that conversation.
    match /accessGrants/{grantId} {
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['adminUid', 'convId', 'auditId', 'viewedAt'])
        && request.resource.data.adminUid == me()
        && grantId == me() + '_' + request.resource.data.convId
        && request.resource.data.viewedAt == request.time
        && auditAfter(request.resource.data.auditId).adminUid == me()
        && auditAfter(request.resource.data.auditId).action == 'view_conversation'
        && auditAfter(request.resource.data.auditId).target == request.resource.data.convId
        && auditAfter(request.resource.data.auditId).createdAt == request.time;
      allow read, delete: if false;
    }

    function adminGranted(convId) {
      let g = /databases/$(database)/documents/accessGrants/$(me() + '_' + convId);
      return isAdmin() && exists(g) && get(g).data.viewedAt > request.time - duration.value(10, 'm');
    }

    // ------------------------------------------------------------ conversations & messages
    // status: 'request'  first contact. The sender (initiator) may send at most 2 messages (reqCount) until the
    //                    other person accepts. The receiver sees it under "Requests", not in the inbox.
    //         'accepted' normal chat (replying, accepting, or a mutual like/match makes it accepted)
    //         'declined' the receiver declined; the sender can't send more
    // Conversations created before this feature have no status and count as 'accepted'.
    function convPath(convId) { return /databases/$(database)/documents/conversations/$(convId); }

    // Both people liked each other (my like is created in this same commit or already exists).
    function mutualLike(convId) {
      let o = otherUser(convId);
      return existsAfter(/databases/$(database)/documents/likes/$(me() + '_' + o))
          && exists(/databases/$(database)/documents/likes/$(o + '_' + me()));
    }

    function validNewConv(d, convId) {
      return d.keys().hasOnly(['participants', 'updatedAt', 'initiator', 'status', 'reqCount'])
        && d.participants == convId.split('_')
        && d.updatedAt == request.time
        && d.initiator == me()
        && ((d.status == 'request' && d.reqCount == 1)
            || (d.status == 'accepted' && d.reqCount == 0 && mutualLike(convId)));
    }

    // A message may only be written in the same commit that updates its conversation, and only if the
    // conversation state allows it.
    function msgOk(convId) {
      let p = convPath(convId);
      let aft = getAfter(p).data;
      return aft.updatedAt == request.time
        && (
          // brand-new request: the very first message
          (!exists(p) && aft.status == 'request' && aft.initiator == me() && aft.reqCount == 1)
          // accepted chat (also older conversations without a status)
          || (exists(p) && get(p).data.get('status', 'accepted') == 'accepted' && aft.get('status', 'accepted') == 'accepted')
          // the receiver replies: that accepts the request
          || (exists(p) && get(p).data.get('status', 'accepted') == 'request' && get(p).data.initiator != me()
              && aft.status == 'accepted')
          // the sender writes again before being accepted: at most 2 in total
          || (exists(p) && get(p).data.get('status', 'accepted') == 'request' && get(p).data.initiator == me()
              && aft.status == 'request' && aft.reqCount <= 2)
        );
    }

    match /conversations/{convId} {
      // Metadata only (who talked, when, request state). Message text is never stored here.
      allow read: if isAdmin() || (canLobby() && me() in resource.data.participants);
      allow create: if canLobby() && validConvId(convId)
        && validNewConv(request.resource.data, convId)
        && notBlocked(convId);
      allow update: if canLobby() && me() in resource.data.participants && notBlocked(convId) && (
          // sender adds another message to a pending request (max 2)
          (resource.data.get('status', 'accepted') == 'request' && resource.data.initiator == me()
            && request.resource.data.status == 'request'
            && resource.data.reqCount < 2
            && request.resource.data.reqCount == resource.data.reqCount + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'reqCount'])
            && request.resource.data.updatedAt == request.time)
          // accepted chat: bump the activity time
          || (resource.data.get('status', 'accepted') == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
            && request.resource.data.updatedAt == request.time)
          // accept: by the receiver, or because both people liked each other
          || (resource.data.get('status', 'accepted') != 'accepted'
            && request.resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && (resource.data.initiator != me() || mutualLike(convId)))
          // decline: only the receiver of a pending request
          || (resource.data.get('status', 'accepted') == 'request' && resource.data.initiator != me()
            && request.resource.data.status == 'declined'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        );
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if (canLobby() && validConvId(convId)) || adminGranted(convId);
        allow create: if canLobby() && validConvId(convId) && notBlocked(convId) && msgOk(convId)
          && request.resource.data.keys().hasOnly(['senderId', 'body', 'img', 'createdAt'])
          && request.resource.data.senderId == me()
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && (request.resource.data.body.size() >= 1 || 'img' in request.resource.data)
          // pictures: registered members only (not guests), one compressed JPEG data URL
          && (!('img' in request.resource.data)
              || (!isGuest() && request.resource.data.img is string
                  && request.resource.data.img.size() > 100 && request.resource.data.img.size() <= 180000))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------ guests
    match /guests/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isGuest() && me() == uid
        && request.resource.data.keys().hasOnly(['nickname', 'gender', 'dob', 'adultConfirmed', 'consentAt', 'createdAt', 'banned'])
        && request.resource.data.gender in ['male', 'female']
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 20
        && request.resource.data.dob is timestamp
        && request.resource.data.dob <= request.time - duration.value(6575, 'd')
        && request.resource.data.adultConfirmed == true
        && request.resource.data.consentAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.banned == false;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned']))
        // sessions created before gender existed may set it once
        || (isGuest() && me() == uid && resource.data.banned == false
          && !('gender' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gender'])
          && request.resource.data.gender in ['male', 'female']);
      allow delete: if false;
    }

    // Public part of a guest (nickname only, never the date of birth), so members can see who messaged them.
    match /guestNames/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin() || canLobby());
      allow list: if false;
      allow create: if isGuest() && me() == uid
        && request.resource.data.keys().hasOnly(['nickname'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname == getAfter(/databases/$(database)/documents/guests/$(me())).data.nickname;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------ random blind chat
    // Members wait in `waiting/{uid}`. Another member of the OPPOSITE gender claims two waiting
    // entries and creates a room in one transaction. Rules enforce the pairing: both entries must be
    // fresh, still "waiting", and of different genders (gender is copied from the profile on create).
    function myGender() {
      return isGuest()
        ? get(/databases/$(database)/documents/guests/$(me())).data.gender
        : get(/databases/$(database)/documents/users/$(me())).data.gender;
    }
    function waitingPath(u) { return /databases/$(database)/documents/waiting/$(u); }

    function validPair(roomId, p) {
      let a = get(waitingPath(p[0])).data;
      let b = get(waitingPath(p[1])).data;
      let a2 = getAfter(waitingPath(p[0])).data;
      let b2 = getAfter(waitingPath(p[1])).data;
      return a.status == 'waiting' && b.status == 'waiting'
        && a.gender != b.gender
        && a.pingAt > request.time - duration.value(2, 'm')
        && b.pingAt > request.time - duration.value(2, 'm')
        && a2.status == 'matched' && a2.roomId == roomId
        && b2.status == 'matched' && b2.roomId == roomId;
    }

    // The room must be brand new in this same commit and contain both the owner of the entry and the caller.
    function matchedInRoom(uid, roomId) {
      let path = /databases/$(database)/documents/rooms/$(roomId);
      return !exists(path)
        && getAfter(path).data.createdAt == request.time
        && uid in getAfter(path).data.participants
        && me() in getAfter(path).data.participants;
    }

    match /waiting/{uid} {
      // You can read your own entry; you can only see entries of the opposite gender that are waiting.
      allow read: if canLobby() && (me() == uid
        || (resource.data.status == 'waiting'
            && resource.data.gender == (myGender() == 'male' ? 'female' : 'male')));

      allow create: if canLobby() && me() == uid
        && request.resource.data.keys().hasOnly(['gender', 'status', 'roomId', 'pingAt'])
        && request.resource.data.gender == myGender()
        && request.resource.data.status == 'waiting'
        && request.resource.data.roomId == null
        && request.resource.data.pingAt == request.time;

      allow update: if canLobby() && (
        // keep-alive ping by the owner
        (me() == uid
          && resource.data.status == 'waiting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pingAt'])
          && request.resource.data.pingAt == request.time)
        // claimed (by the owner or by the matching partner) together with a brand-new room
        || (resource.data.status == 'waiting'
          && request.resource.data.status == 'matched'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'roomId'])
          && request.resource.data.roomId is string
          && matchedInRoom(uid, request.resource.data.roomId)));

      allow delete: if signedIn() && (me() == uid
        || (canLobby() && resource.data.pingAt < request.time - duration.value(3, 'm')));
    }

    match /rooms/{roomId} {
      allow read: if isAdmin() || (canLobby() && me() in resource.data.participants);
      allow create: if canLobby()
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'ended'])
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && me() in request.resource.data.participants
        && request.resource.data.createdAt == request.time
        && request.resource.data.ended == false
        && validPair(roomId, request.resource.data.participants);
      // either person can hang up; it can never be undone
      allow update: if canLobby() && me() in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ended'])
        && request.resource.data.ended == true;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if (canLobby() && me() in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants)
          || adminGranted(roomId);
        allow create: if canLobby()
          && me() in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.ended == false
          && request.resource.data.keys().hasOnly(['senderId', 'body', 'createdAt'])
          && request.resource.data.senderId == me()
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
